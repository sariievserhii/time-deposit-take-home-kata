# Project-wide Lombok settings (picked up from this directory down).
config.stopBubbling = true

# Mark generated code with @lombok.Generated, so coverage tools (JaCoCo) don't count boilerplate as untested.
lombok.addLombokGeneratedAnnotation = true

# Fail the build on Lombok features that are dangerous on JPA entities or hide too much. Entities use only @Getter,
# single-field @Setter, @NoArgsConstructor(access = PROTECTED) and @Builder (see TimeDepositJpaEntity).
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.experimental.flagUsage = error
